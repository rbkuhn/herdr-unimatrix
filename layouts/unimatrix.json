{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "block",
      "content": {
        "mod": "unimatrix-rail"
      },
      "size": {
        "px": 76
      },
      "min": 76,
      "max": 76,
      "background": {
        "image": "mods/unimatrix-rail/art/rail.png",
        "fit": "cover"
      },
      "border": {
        "width": 1,
        "color": "#0d2a22"
      }
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "unimatrix-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true,
          "background": {
            "image": "mods/unimatrix-rail/art/strip.png",
            "fit": "cover"
          }
        },
        {
          "id": "board",
          "type": "block",
          "content": {
            "mod": "unimatrix-board"
          },
          "size": {
            "px": 196
          },
          "min": 110,
          "max": 420,
          "background": {
            "image": "mods/unimatrix-rail/art/board.png",
            "fit": "cover"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "unimatrix-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/unimatrix-rail/art/map.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "#174d3c"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#36e27a"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "vitals",
                  "type": "block",
                  "content": {
                    "mod": "unimatrix-vitals"
                  },
                  "size": {
                    "px": 292
                  },
                  "background": {
                    "image": "mods/unimatrix-rail/art/vitals.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "#174d3c"
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "inbox",
                      "type": "block",
                      "content": {
                        "mod": "inbox"
                      }
                    }
                  ],
                  "active": "changes",
                  "border": {
                    "width": 1,
                    "color": "#174d3c"
                  },
                  "background": "surface"
                }
              ],
              "size": {
                "px": 330
              },
              "min": 280,
              "max": 700,
              "gap": 8
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 26
          },
          "background": {
            "image": "mods/unimatrix-rail/art/footer.png",
            "fit": "cover"
          }
        }
      ],
      "divider": {
        "width": 1,
        "color": "#0d2a22"
      }
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "unimatrix",
  "terminal_opacity": 0.5,
  "ui_font": "Pixelify Sans",
  "preview": "layouts/unimatrix.png"
}
